# =====================================================================
# BMU Website Chatbot - Environment Configuration Template
# Copy this file to '.env' and fill in your personal API keys and settings.
# =====================================================================

# ---------------------------------------------------------------------
# 1. ChromaDB Cloud Configuration (https://trychroma.com)
# ---------------------------------------------------------------------
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=BMU_WEBSITE_CHATBOT

# ---------------------------------------------------------------------
# 2. Groq Cloud API Keys (https://console.groq.com)
# Note: You can use a single GROQ_API_KEY for all agents, or dedicated keys.
# ---------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Agent 1: Query Specialist
GROQ_API_KEY_QUERY_AGENT=your_groq_api_key_here
GROQ_MODEL_QUERY_AGENT=openai/gpt-oss-20b

# Agent 2: Context Auditor & Route Decider
GROQ_API_KEY_CONTEXT_AGENT=your_groq_api_key_here
GROQ_MODEL_CONTEXT_AGENT=openai/gpt-oss-20b

# Agent 3: Academic Response Synthesizer
GROQ_API_KEY_SYNTHESIS_AGENT=your_groq_api_key_here
GROQ_MODEL_SYNTHESIS_AGENT=openai/gpt-oss-120b

# ---------------------------------------------------------------------
# 3. TypeSafe AI JEV Guardrail (Optional: falls back to local System-One engine)
# ---------------------------------------------------------------------
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------
# 4. Service Hosts, Ports, and Endpoints
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RETRIEVAL_HOST=0.0.0.0
RETRIEVAL_SERVICE_PORT=8001
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8001

# ---------------------------------------------------------------------
# 5. Local LLM Configuration (Ollama / OpenAI-compatible local server)
# ---------------------------------------------------------------------
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_API_KEY=ollama

# ---------------------------------------------------------------------
# 6. Voyage AI & Ingestion Microservice (Optional)
# ---------------------------------------------------------------------
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_API_ENDPOINT=https://ai.mongodb.com/v1/embeddings
VOYAGE_MODEL_NAME=voyage-4-large
VOYAGE_COLLECTION_NAME=bmu_voyage_knowledge
INGESTION_SERVICE_PORT=8002
INGESTION_HOST=0.0.0.0

# ---------------------------------------------------------------------
# 7. Arize Phoenix Observability (Optional: http://localhost:6006)
# ---------------------------------------------------------------------
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=bmu-website-chatbot
